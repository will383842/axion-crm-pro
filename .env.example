# =============================================================================
# Axion CRM Pro — .env.example
# Copier vers .env (gitignored) et adapter
# =============================================================================

# --- Mode mocks (Sprint 1-12 par défaut) -------------------------------------
MOCK_MODE=true
MOCK_LLM=true
MOCK_PROXIES=true
MOCK_SCRAPERS=true
MOCK_SMTP=true
MOCK_CAPTCHA=true
MOCK_INSEE=false
MOCK_ANNUAIRE_ENTREPRISES=false
MOCK_BODACC=false
MOCK_BAN=false
MOCK_FRANCE_TRAVAIL=false

# --- Laravel core ------------------------------------------------------------
APP_NAME="Axion CRM Pro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# ⚠️ ORIGINE UNIQUE, comme `VITE_API_BASE_URL` plus bas : depuis le sprint 19.6
# le SPA et l'API sont servis sous le MÊME hôte (`app.localhost` en local,
# `app.axion-crm-pro.com` en production), Caddy routant `/api/*` et
# `/sanctum/*` vers le backend. Laisser `api.localhost` ici fabrique des URL
# absolues (liens d'e-mail, URL signées, `asset()`) qui pointent une origine
# où le cookie de session n'existe pas — le lien s'ouvre déconnecté.
APP_URL=https://app.localhost
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=Europe/Paris

# --- Telescope ---------------------------------------------------------------
# 🔴 FALSE PAR DÉFAUT, et ce n'est pas une préférence.
#
# `laravel/telescope` est une dépendance dure (`backend/composer.json`) dont le
# défaut amont est `enabled = true`, mais ce dépôt n'a JAMAIS publié ses
# migrations : `backend/database/migrations/` n'en contient aucune. Telescope
# enregistre à la TERMINAISON de chaque requête et de chaque commande — donc,
# sur toute base à jour, chaque appel finit en :
#
#     SQLSTATE[42P01] relation "telescope_entries" does not exist
#
# Mesuré le 2026-08-18 : 54 migrations passées, 0 en attente, 0 table
# `telescope*`, `GET /api/v1/config/features` → 500. La clé manquait ici, si
# bien que toute installation neuve était cassée dès sa première requête.
#
# Pour s'en servir vraiment : `php artisan telescope:install` puis `migrate`,
# et repasser cette clé à `true`.
TELESCOPE_ENABLED=false

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database ----------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=axion_crm
DB_USERNAME=axion
DB_PASSWORD=axion_dev_only
DB_SCHEMA=public

# --- Isolation par workspace (lot L0, 2026-08-14) -----------------------------
# `axion` (POSTGRES_USER) est SUPERUSER + BYPASSRLS : la Row Level Security ne
# s'applique PAS a lui. Le role `axion_app`, non-proprietaire, y est soumis.
# La migration 2026_08_14_000001 cree le role et ses privileges ; le mot de passe
# ci-dessous est une valeur de DEVELOPPEMENT — en prod il est pose dans le `.env`
# du serveur (non versionne) et n'apparait jamais dans un commit.
DB_APP_USERNAME=axion_app
DB_APP_PASSWORD=axion_app_dev_only
# Drapeau d'activation : a false, l'application se connecte comme avant (donc
# durcissement INERTE). A true, elle passe sur `axion_app` et la RLS mord.
CRM_DB_APP_ROLE_ENABLED=false
# Ceinture applicative : global scope Eloquent + echec bruyant sans contexte.
CRM_STRICT_WORKSPACE_SCOPE=false

# --- Ingestion site -> CRM (lot L2, 2026-08-14) -------------------------------
# Endpoint `POST /api/internal/site-sync`, signe HMAC-SHA256 (patron de
# /internal/scraper-result), rate limiter `internal` 600/min.
# Drapeau MAITRE : a false, l'endpoint repond 503 `ingest_disabled` et n'ecrit
# RIEN. L'outbox du site garde alors ses lignes en attente et les rejouera le
# jour de la bascule — un 503 ne solde jamais une ligne.
CRM_INGEST_ENABLED=false
# Second verrou, propre a l'univers VIVIER. Ne passe a true qu'APRES que les
# textes de consentement v2 sont servis en prod sur le site. Meme a true, une
# fiche candidat sans consentement v2 est REJETEE (422) : le drapeau ouvre le
# flux, il ne dispense jamais de la preuve du consentement.
CRM_INGEST_CANDIDATES_ENABLED=false
# Secret partage du canal site->CRM (64 hex : `openssl rand -hex 32`). En prod
# il est pose dans le `.env` du serveur (non versionne) et cote site par l'API
# Coolify — jamais dans un commit.
SITE_SYNC_HMAC_SECRET=
# Workspace commercial de destination (le site n'a PAS a le connaitre : la
# destination est une decision du CRM, pas une donnee du payload).
CRM_INGEST_BUSINESS_WORKSPACE=axion-ia
# Fenetre de tolerance de l'horodatage signe, en secondes (anti-rejeu).
CRM_INGEST_MAX_CLOCK_SKEW=300

# --- Cache + Queues + Sessions -----------------------------------------------
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# ⚠️ VIDE en local, et ce n'est pas un oubli : `localhost` est un domaine de
# premier niveau, et les navigateurs REFUSENT un cookie `Domain=.localhost`.
# Vide = cookie host-only sur `app.localhost`, lisible par le SPA servi depuis
# la même origine (cf. le bloc `app.localhost` du Caddyfile).
# En production : SESSION_DOMAIN=.axion-crm-pro.com
SESSION_DOMAIN=
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_QUEUE_DB=1
REDIS_CACHE_DB=2
HORIZON_PREFIX=horizon:axion-crm:

# --- Sanctum SPA -------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=app.localhost,localhost,127.0.0.1
SESSION_COOKIE=axion_crm_session
FRONTEND_URL=https://app.localhost

# --- Owner initial (utilisé une seule fois par OwnerUserSeeder) --------------
OWNER_INITIAL_EMAIL=williamsjullin@gmail.com
OWNER_INITIAL_NAME="Williams Jullin"
OWNER_INITIAL_PASSWORD=

# --- LLM providers (placeholders, ignorés en MOCK_MODE) ----------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=

# --- Proxies (placeholders, ignorés en MOCK_MODE) ---------------------------
WEBSHARE_API_KEY=
IPROYAL_API_KEY=
TWOCAPTCHA_API_KEY=

# --- Brave Search API (Sprint H1 — remplace DuckDuckGo scrape) ---------------
# https://api.search.brave.com/app/keys — 2000 req/mois free, $5/1K ensuite
BRAVE_SEARCH_API_KEY=

# --- Hunter.io email verification (Sprint H2) --------------------------------
# https://hunter.io/api-keys — 25 vérifs/mois free, $34/mo plan Starter 1K
HUNTER_API_KEY=

# --- Webshare proxies pour Pages Jaunes (Sprint H1, Phase B uniquement) ------
# Désactivé par défaut, activer après validation Phase A Will (~$30/mo flat)
WEBSHARE_ENABLED=false
WEBSHARE_USERNAME=
WEBSHARE_PASSWORD=
WEBSHARE_ENDPOINT=p.webshare.io:80

# --- Google Places API (Sprint H9 + H12 + H14, recommandé Phase A) -----------
# Enrichissement auto téléphone/website/horaires/note Google. Free tier ~12K
# lookups/mois grâce au crédit Maps Platform $200/mois. Console GCP :
# https://console.cloud.google.com/ → projet axion-crm-pro → Places API (New)
GOOGLE_PLACES_API_KEY=
# Cache des réponses Google Places (default 30 jours)
GOOGLE_PLACES_CACHE_TTL_DAYS=30
# Sprint H12 — Hard cap mensuel d'appels (default 11500, marge 500 sur 12K free)
# Au-delà : skip + marker signals.google_places_pending pour retry mois suivant
GOOGLE_PLACES_MONTHLY_QUOTA_LIMIT=11500
# Sprint H14 — Smart skip : ne pas appeler Google Places si entreprise a déjà
# email exploitable + phone + website (économise quota pour les cas vraiment utiles)
GOOGLE_PLACES_SMART_SKIP=true
# Sprint H14 — Seuil au-delà duquel le KpiCard /admin/observability passe en alerte rose
GOOGLE_PLACES_PENDING_ALERT_THRESHOLD=5000

# --- EmailFinder spéculatif (Sprint H7, politique Will : OFF par défaut) -----
# Si true : EmailFinderService génère 18 patterns spéculatifs (jean.dupont@...).
# Activer UNIQUEMENT si un vrai vérificateur SMTP externe (Hunter/ZeroBounce)
# est wired pour valider les candidats. Sinon laisser false (doctrine "0 email
# douteux" : la base ne contient QUE les emails réels scrapés mentions-légales).
EMAIL_FINDER_SPECULATIVE_ENABLED=false

# --- Santé / RPPS (Annuaire Santé « PS LibreAccès ») ------------------------
# Verticale santé : spécialité médicale + tél des pros de santé (rpps:import).
# ⚠️ Donnée nominative de SANTÉ (RGPD art. 9). L'import RÉEL est REFUSÉ tant que
# SANTE_INGESTION_ENABLED=false. N'activer qu'APRÈS validation de l'AIPD dédiée.
SANTE_INGESTION_ENABLED=false
# MOCK_RPPS=true en dev → rpps:import seede des praticiens fictifs (défaut MOCK_MODE).
MOCK_RPPS=true

# --- INSEE Sirene (gratuit, recommandé activer) -----------------------------
# Choisir UN des 2 modes selon plan souscrit sur portail-api.insee.fr :
# Mode 1 (Accès public, 30 req/min) : ne remplir QUE INSEE_API_KEY
INSEE_API_BASE_URL=https://api.insee.fr
INSEE_API_KEY=
# Mode 2 (Accès authentifié OAuth2, 500 req/min) : ne remplir QUE les 2 vars ci-dessous
INSEE_CLIENT_ID=
INSEE_CLIENT_SECRET=

# --- annuaire-entreprises ----------------------------------------------------
ANNUAIRE_ENTREPRISES_BASE_URL=https://recherche-entreprises.api.gouv.fr
BODACC_BASE_URL=https://bodacc-datafluide.opendatasoft.com
BAN_BASE_URL=https://api-adresse.data.gouv.fr
FRANCE_TRAVAIL_BASE_URL=https://api.francetravail.io

# --- SMTP probe --------------------------------------------------------------
SMTP_PROBE_FROM_DOMAIN=axion-crm.local
SMTP_PROBE_FROM_EMAIL=postmaster@axion-crm.local
SMTP_PROBE_TIMEOUT_S=8

# --- Telemetry / Observability ------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=axion-crm-backend
GLITCHTIP_DSN=

# --- Sécurité ----------------------------------------------------------------
AUDIT_HASH_CHAIN_SECRET=
RATE_LIMIT_PER_MINUTE=60
SSRF_GUARD_DENY_PRIVATE=true

# --- Frontend (Vite, prefix VITE_) -------------------------------------------
# ORIGINE NUE (schéma + hôte), SANS `/api` ni barre finale : le client
# ajoute `/api/v1`. En prod : https://app.axion-crm-pro.com
# ⚠️ ORIGINE DU SPA, pas celle de l'API : le Caddyfile route `/api/*` et
# `/sanctum/*` vers le backend sous CETTE origine (single origin). Pointer
# `https://api.localhost` ici remet le SPA et l'API sur deux origines — et la
# session ne s'établit plus (cf. Caddyfile, bloc `app.localhost`).
VITE_API_BASE_URL=https://app.localhost
VITE_APP_NAME="Axion CRM Pro"
VITE_MAPLIBRE_TILES_URL=https://tiles.openfreemap.org/styles/liberty
VITE_SENTRY_DSN=

# --- Workers (Node) ----------------------------------------------------------
WORKER_TYPE=google-maps
WORKER_CONCURRENCY=2
WORKER_REDIS_URL=redis://redis:6379/1
WORKER_INTERNAL_HMAC_SECRET=
WORKER_INTERNAL_RESULT_URL=http://api:80/internal/scraper-result

# --- Funnel d'ingestion de la collecte (lot L3, 2026-08-14) --------------------
# A false (defaut), POST /internal/scraper-result garde son comportement
# HISTORIQUE (log-only, 200) : le funnel est livre mais inerte. A true, le
# meme endpoint valide le schema pivot ScrapedRecord et ingere reellement
# (registre -> idempotence -> dedup -> backfill-only -> tags -> timeline).
CRM_SCRAPE_FUNNEL_ENABLED=false
# Validation DNS (MX/A) des emails collectes — « jamais confiance au
# collecteur ». false en tests (aucun appel reseau reel, regle MOCK_*).
CRM_SCRAPE_VALIDATE_MX=true
# Backfill des tags src:scraping-* sur le stock (4,29 M) : DERNIER acte de la
# mission (ordre de mission §5), jamais avant. La commande
# scraping:backfill-src-tags refuse tant que ce drapeau n'est pas a true.
CRM_BACKFILL_ENABLED=false

# --- Purges RGPD par univers (lot L4, 2026-08-14) ------------------------------
# A false, rgpd:purge-vivier et rgpd:purge-business-prospects refusent et le
# scheduler les saute. Activation a la bascule finale, comme le reste.
CRM_PURGE_ENABLED=false

# --- Mini-outbox CRM -> site (lot L5, 2026-08-14) ------------------------------
# Convergence BIDIRECTIONNELLE des consentements : une opposition NEE dans la
# console CRM doit remonter au site, sinon les deux systemes se reecrivent a des
# opposes (le site reabonne quelqu'un que le CRM a oppose).
# A false, `crm:flush-outbound` REFUSE et le scheduler la saute (double verrou,
# comme les purges). Le producteur, lui, ecrit toujours sa ligne en base : c'est
# un journal local qui ne sort pas du serveur. A l'activation, le backlog part
# par lots (`crm:flush-outbound --limit`).
CRM_OUTBOUND_ENABLED=false
# Endpoint webhook du site (POST). Vide = la commande refuse : on ne devine pas
# une destination.
SITE_CRM_WEBHOOK_URL=
# Le secret de signature n'est PAS duplique : c'est le MEME
# SITE_SYNC_HMAC_SECRET que le canal site->CRM (corps signe <timestamp>.<corps>,
# en-tetes X-Crm-Timestamp / X-Crm-Signature). Un seul secret a faire tourner.
# Essais CONSOMMES avant abandon definitif (`gave_up`). Un 503 du site n'en
# consomme AUCUN : une maintenance de quelques heures ne doit pas bruler le
# budget de retry et abandonner des oppositions valides.
CRM_OUTBOUND_MAX_ATTEMPTS=8
CRM_OUTBOUND_TIMEOUT=10
CRM_OUTBOUND_BATCH=100
# --- Console CRM v2 (lot L6, 2026-08-14) ---------------------------------------
# Console « 3 espaces » du plan §2.11 et de la conception UX v2.
# A false (defaut) :
#   - toutes les routes /api/v1/crm/* de la console repondent 404 ;
#   - GET /api/v1/config/features annonce console_v2:false, donc le frontend
#     n'affiche RIEN de neuf (aucune entree de navigation, aucune route).
# Pourquoi 404 et pas 503 : un 503 promet un reessai, ce qui a du sens pour un
# canal d'ingestion dont l'emetteur doit rejouer sa ligne (L2/L3). La console
# n'a rien a rejouer, et un 404 ne divulgue pas l'existence d'une surface fermee.
# Rollback = remettre a false + redemarrer. Aucune migration a defaire.
CRM_CONSOLE_V2_ENABLED=false

# ─── E-mail transactionnel du CRM — voie B du cahier des charges §9.0 (étape 0, ligne 3 ter) ───
# Le CRM n'envoie RIEN tant que le cahier des charges ne le demande pas : `MAIL_MAILER`
# reste `log` par défaut. Le jour venu, la voie B passe par le MÊME service transactionnel
# que le site (ZeptoMail), avec un Mail Agent PROPRE au CRM (jeton distinct de celui du site,
# révocable sans le toucher) — Will crée l'agent, colle le jeton dans les secrets, jamais ici.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.zeptomail.eu
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=emailapikey
# MAIL_PASSWORD=            # jeton d'envoi du Mail Agent « Axion CRM Pro » — secret
# MAIL_FROM_ADDRESS=crm@axion-ia.com
# MAIL_FROM_NAME="Axion IA — CRM"
# Rebonds / plaintes → liste de suppression : URL du webhook à coller dans le Mail Agent :
#   https://api.axion-crm-pro.com/api/internal/email/zeptomail?t=<MAIL_WEBHOOK_TOKEN>
# Sans jeton, la route répond 503 et n'écrit rien.
# MAIL_WEBHOOK_TOKEN=       # 64 hex, généré : openssl rand -hex 32 — secret

# --- COURRIEL ---------------------------------------------------------------
# MAIL_MAILER n'etait defini NULLE PART : ni ici, ni dans configure-prod-env.sh.
# Laravel retombait donc sur son defaut `log`, et AUCUN courriel ne partait.
# Un defaut implicite est une decision que personne n'a prise : on l'ecrit.
MAIL_MAILER=log
#
# Transport des SEULS courriels d'authentification (lien magique,
# reinitialisation de mot de passe). Ce ne sont pas du courrier commercial : ce
# sont les deux portes de secours d'un compte, et `log` les coupait aussi.
# Vide = meme transport que MAIL_MAILER. Poser `smtp` les laisse sortir, EUX SEULS.
MAIL_MAILER_AUTH=
