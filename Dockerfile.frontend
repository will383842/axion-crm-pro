# Axion CRM Pro — Dockerfile React 19 + Vite 6 multi-stage

ARG NODE_VERSION=22-alpine

# -----------------------------------------------------------------------------
# 1) deps : install pnpm + node_modules
# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION} AS deps
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /srv/app
# 🔴 Lock SANS joker, et install SANS repli — le meme defaut que
# `Dockerfile.worker` et `Dockerfile.laravel`, corriges tous deux ; celui-ci
# avait ete oublie. C'est pourtant le plus expose des trois : il construit
# l'image `app` SERVIE EN PRODUCTION.
#
# Le joker rendait le verrou facultatif, et le repli `|| pnpm install`
# resolvait alors « les dernieres versions » en silence. Les deux ensemble
# vidaient de son sens tout durcissement de dependances : un verrou qui ne
# colle plus a `package.json` n'arretait pas le build, il etait CONTOURNE, et
# la production embarquait des versions que personne n'avait mesurees.
#
# Verrou absent ou perime = build en echec. C'est le seul comportement qui
# rende le verrou vrai.
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# -----------------------------------------------------------------------------
# 2) dev : vite dev server (HMR) — conservé pour devs locaux
# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION} AS dev
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /srv/app
COPY --from=deps /srv/app/node_modules ./node_modules
COPY frontend/ ./
ENV NODE_ENV=development
EXPOSE 5173
CMD ["pnpm", "dev", "--host", "0.0.0.0"]

# -----------------------------------------------------------------------------
# 3) builder : compile typecheck + vite build → dist/
# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION} AS builder
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /srv/app
COPY --from=deps /srv/app/node_modules ./node_modules
COPY frontend/ ./
ARG VITE_API_BASE_URL
ARG VITE_SENTRY_DSN
# Signal explicite « ce bundle part en production » : seul l overlay prod le
# pose. Il arme la garde de `vite.config.ts` contre une base d API locale.
ARG VITE_BUILD_CIBLE
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN
ENV VITE_BUILD_CIBLE=$VITE_BUILD_CIBLE
ENV NODE_ENV=production
RUN pnpm build

# -----------------------------------------------------------------------------
# 3 bis) caddy-build : le binaire Caddy RECOMPILE avec un Go et des
#   dependances corriges (2026-10-01).
#
# `caddy:2-alpine` (republie le 2026-09-23) embarque TOUJOURS Caddy v2.11.4
# compile avec Go 1.26.3 et golang.org/x/crypto 0.52, x/net 0.55, x/text 0.37,
# grpc 1.81 : 17 HIGH (Trivy, `usr/bin/caddy`). Aucun tag plus recent n'existe
# (v2.11.4 est la derniere version publiee). Un binaire Go embarque ses
# dependances : seul un Caddy recompile les corrige — c'est ce que fait ce
# stade, exactement comme `xcaddy` (module `main` minimal + `go get`), mais
# SANS remplacement (`replace`) : les versions corrigees sont les vraies
# versions requises, donc celles que lit Trivy dans le binaire.
#
# Versions = celles exigees par les avis (Go >= 1.26.6, x/crypto >= 0.55.0,
# x/net >= 0.56.0, x/text >= 0.39.0, grpc >= 1.83.2), toutes epinglees ;
# x/net 0.58.0 et x/text 0.41.0 car grpc 1.83.2 et x/crypto 0.55.0 les exigent.
# Au reexamen : si une image `caddy:2-alpine` recompilee corrige ces avis,
# ce stade peut disparaitre (et le `COPY --from=caddy-build` avec lui).
# -----------------------------------------------------------------------------
FROM golang:1.26.8-alpine@sha256:8ac98ca534ac3f51e1f420a1dd2c15e74c75cfa0f23f3ad27eb5d7236c349a0c AS caddy-build
ARG CADDY_VERSION=v2.11.4
WORKDIR /src/caddy
ENV CGO_ENABLED=0 GOFLAGS=-trimpath
RUN printf '%s\n' \
        'package main' \
        '' \
        'import (' \
        '    caddycmd "github.com/caddyserver/caddy/v2/cmd"' \
        '    _ "github.com/caddyserver/caddy/v2/modules/standard"' \
        ')' \
        '' \
        'func main() { caddycmd.Main() }' > main.go \
    && go mod init caddy \
    && go get \
        github.com/caddyserver/caddy/v2@${CADDY_VERSION} \
        golang.org/x/crypto@v0.55.0 \
        golang.org/x/net@v0.58.0 \
        golang.org/x/text@v0.41.0 \
        google.golang.org/grpc@v1.83.2 \
    && go mod tidy \
    && go build -ldflags '-s -w' -o /usr/bin/caddy . \
    && /usr/bin/caddy version

# -----------------------------------------------------------------------------
# 4) prod : Caddy 2 alpine sert dist/ sur :5173 (SPA fallback)
#   Image minimale, zéro Node en runtime, garde le port 5173 attendu par Caddy.
# -----------------------------------------------------------------------------
FROM caddy:2-alpine AS prod
# ⚠️ 2026-08-16 — mises à jour de sécurité des paquets Alpine. L'analyse
# Trivy (jusqu'ici jamais exécutée sur cette image : elle était construite
# puis jetée) a relevé 5 vulnérabilités HIGH corrigées en amont mais absentes
# de l'image : c-ares (usage après libération), curl et libcurl (transfert de
# fichier erroné sur SMB, fuite de cookie entre hôtes).
#
# Le binaire Caddy de l'image, lui, est REMPLACE par celui du stade
# `caddy-build` (recompile avec un Go et des dependances corriges) : les HIGH
# de `usr/bin/caddy` ne relevent pas d'`apk upgrade`.
RUN apk --no-cache upgrade
COPY --from=caddy-build /usr/bin/caddy /usr/bin/caddy
WORKDIR /srv/app
COPY --from=builder /srv/app/dist /srv/app/dist
COPY frontend/Caddyfile.app /etc/caddy/Caddyfile
EXPOSE 5173
HEALTHCHECK --interval=30s --timeout=5s --retries=5 \
    CMD wget -qO- http://localhost:5173/ || exit 1

# -----------------------------------------------------------------------------
# 4 bis) caddy-bordure : le proxy de BORDURE `axion-crm-caddy` (2026-10-01)
#   Publié sur 80/443, il TERMINE LE TLS : c'est lui que visent au premier
#   chef les CVE crypto/tls, crypto/x509 et net/http du binaire de
#   `caddy:2-alpine`. Même base, même binaire recompilé (stade `caddy-build`)
#   que le conteneur `app` — un seul binaire Caddy dans tout le dépôt.
#   Aucun fichier copié : `infra/caddy/Caddyfile`, `/data` et `/config` sont
#   montés par `docker-compose.yml`, comme avant.
#   Modules : `infra/caddy/Caddyfile` n'emploie que des directives de
#   `modules/standard` (reverse_proxy + transport fastcgi, encode zstd/gzip,
#   header, handle, rewrite, root, tls internal, ACME HTTP par défaut,
#   trusted_proxies static) — aucun plugin (pas de DNS-01).
#   Placé AVANT `prod-nginx` : le dernier stade (cible par défaut) ne change pas.
# -----------------------------------------------------------------------------
FROM caddy:2-alpine AS caddy-bordure
RUN apk --no-cache upgrade
COPY --from=caddy-build /usr/bin/caddy /usr/bin/caddy

# -----------------------------------------------------------------------------
# 5) prod-nginx : ancien target nginx, conservé pour rollback
# -----------------------------------------------------------------------------
FROM nginx:1.31-alpine AS prod-nginx
COPY infra/nginx/frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /srv/app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=5 \
    CMD wget -qO- http://localhost/healthz || exit 1
CMD ["nginx", "-g", "daemon off;"]
