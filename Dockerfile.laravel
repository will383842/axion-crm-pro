# Axion CRM Pro — Dockerfile Laravel 12 + PHP 8.3 multi-stage
# Stages : composer-deps → php-base → dev → builder → prod

ARG PHP_VERSION=8.3
ARG COMPOSER_VERSION=2.7

# -----------------------------------------------------------------------------
# 1) composer-deps : cache des dépendances vendor/
# -----------------------------------------------------------------------------
FROM composer:${COMPOSER_VERSION} AS composer-deps
WORKDIR /app

# `composer.lock` SANS joker : le joker rendait le lock facultatif, et Composer
# se rabattait alors sur « résoudre les dernières versions » — deux builds du
# MÊME commit pouvaient embarquer des dépendances différentes. Un lock absent
# doit faire échouer le build, pas le rendre imprévisible.
COPY backend/composer.json backend/composer.lock ./

# `--ignore-platform-reqs` : cette étape TÉLÉCHARGE les paquets, elle n'exécute
# rien. L'image `composer` n'a ni pgsql, ni redis, ni intl, ni pcntl — c'est
# `php-base` qui les porte, et c'est là que l'autoload et les commandes artisan
# tournent réellement. Sans ce drapeau, l'étape échoue sur des extensions dont
# elle n'a aucun usage.
#
# Le repli `|| composer install` (sans `--no-dev`) qui existait ici a été
# RETIRÉ : au moindre échec, il réinstallait silencieusement les dépendances de
# DÉVELOPPEMENT dans une image de production. Un repli qui dégrade la sécurité
# sans le dire est pire que l'échec qu'il masque.
RUN composer install \
        --no-dev \
        --no-scripts \
        --no-autoloader \
        --no-interaction \
        --prefer-dist \
        --ignore-platform-reqs

# -----------------------------------------------------------------------------
# 2) php-base : PHP-FPM + extensions communes
# -----------------------------------------------------------------------------
FROM php:${PHP_VERSION}-fpm-alpine AS php-base

RUN apk add --no-cache \
        bash curl git icu-dev libpng-dev libjpeg-turbo-dev libwebp-dev \
        oniguruma-dev libzip-dev libxml2-dev postgresql-dev nodejs npm \
        fcgi \
        autoconf g++ make linux-headers \
    && docker-php-ext-configure intl \
    && docker-php-ext-install -j$(nproc) \
        intl pdo pdo_pgsql pgsql opcache bcmath pcntl exif zip gd mbstring \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del autoconf g++ make linux-headers \
    && rm -rf /var/cache/apk/*

COPY --from=composer:2.7 /usr/bin/composer /usr/local/bin/composer

WORKDIR /var/www/html

# -----------------------------------------------------------------------------
# 3) dev : montage volume bind, opcache off
# -----------------------------------------------------------------------------
FROM php-base AS dev
ENV APP_ENV=local APP_DEBUG=true
RUN echo "opcache.enable=0" > /usr/local/etc/php/conf.d/zz-opcache-dev.ini
COPY infra/php/fpm-axion.conf /usr/local/etc/php-fpm.d/zz-axion.conf
# 🔴 9000, et php-fpm — comme la production. Constat A-010 (S0).
#
# Ce commentaire disait : « la commande par défaut sera fournie par
# docker-compose (php-fpm ou artisan) ». Aucun fichier `docker-compose` n'en a
# jamais fourni. La commande de repli — `php -S`, un seul processus — servait
# donc TOUT, développement comme production, depuis le premier jour.
#
# L'atelier local doit ressembler à la production, sinon il ne prouve rien :
# c'est déjà écrit noir sur blanc dans `infra/caddy/Caddyfile` à propos de
# l'origine unique. La même règle vaut ici.
EXPOSE 9000
CMD ["php-fpm", "-F"]

# -----------------------------------------------------------------------------
# 4) builder : compose autoload + cache config + build front public assets
# -----------------------------------------------------------------------------
FROM php-base AS builder
ENV APP_ENV=production APP_DEBUG=false
COPY backend/ /var/www/html/
COPY --from=composer-deps /app/vendor /var/www/html/vendor
# `bootstrap/cache` et `storage/*` sont des dossiers VIDES : git ne les suit
# pas, donc le checkout CI ne les a pas — alors qu'ils existent sur tout poste
# de dev. Sans eux, `package:discover` (déclenché par dump-autoload) échoue sur
# « bootstrap/cache must be present and writable ». Un build qui ne passe que
# là où le dépôt a déjà servi n'est pas un build.
RUN mkdir -p bootstrap/cache \
        storage/app/public \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs
# 🔴 NE PAS remettre `config:cache` / `route:cache` / `view:cache` ICI.
#
# Au build, il n'y a pas de `.env` : ni `DB_HOST`, ni `DB_PASSWORD`, ni
# `REDIS_HOST`, ni `DB_TIMEZONE`. Un `config:cache` fige donc les valeurs par
# défaut (`DB_HOST=127.0.0.1`…), et sous config mise en cache `env()` retourne
# NUL — plus rien ne relit le `.env` au démarrage. La base devient injoignable.
# Piège déjà payé sur ce projet le 2026-08-14.
#
# Ces trois caches sont désormais construits par `infra/docker/entrypoint-prod.sh`
# au DÉMARRAGE du conteneur, quand l'environnement réel est injecté.
RUN composer dump-autoload --classmap-authoritative --optimize \
    && php artisan storage:link || true \
    && chown -R www-data:www-data storage bootstrap/cache

# -----------------------------------------------------------------------------
# 5) prod : runtime minimal, opcache on
# -----------------------------------------------------------------------------
FROM php-base AS prod
ENV APP_ENV=production APP_DEBUG=false
# `opcache.preload` a été RETIRÉ : il pointait sur `/var/www/html/preload.php`,
# un fichier qui n'existe pas dans le dépôt. PHP émettait donc une erreur de
# démarrage à chaque lancement. On ne déclare pas un préchargement sans le
# fichier qui va avec.
RUN echo "opcache.enable=1" > /usr/local/etc/php/conf.d/zz-opcache-prod.ini \
    && echo "opcache.validate_timestamps=0" >> /usr/local/etc/php/conf.d/zz-opcache-prod.ini
COPY --from=builder /var/www/html /var/www/html
COPY infra/docker/entrypoint-prod.sh /usr/local/bin/entrypoint-prod
# Pool php-fpm — le fichier porte la mesure qui le justifie.
COPY infra/php/fpm-axion.conf /usr/local/etc/php-fpm.d/zz-axion.conf
RUN chmod +x /usr/local/bin/entrypoint-prod
USER www-data
# 🔴 9000 ET NON 80 — constat A-010 (S0) de l'audit 360.
#
# Ce service ne sert plus HTTP : il parle FastCGI, et c'est Caddy qui parle HTTP
# au monde. Le port déclaré doit dire ce que le service fait réellement, sinon
# le prochain qui lit ce fichier branchera un mandataire sur 80 et prendra 502.
EXPOSE 9000
# Le contrôle de santé interrogeait `http://localhost/up`. Il n'y a plus de
# serveur HTTP ici : ce contrôle échouerait TOUJOURS, le conteneur serait
# déclaré malsain en permanence, et le déploiement le redémarrerait en boucle.
# Un correctif de performance aurait alors provoqué une panne totale.
# On interroge donc php-fpm dans SA langue, sur le point de vie que déclare
# `infra/php/fpm-axion.conf`.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=5 \
    CMD SCRIPT_NAME=/ping SCRIPT_FILENAME=/ping REQUEST_METHOD=GET \
        cgi-fcgi -bind -connect 127.0.0.1:9000 2>/dev/null | grep -q pong || exit 1
# L'entrypoint construit config/route/view caches avec l'environnement RÉEL,
# puis passe la main à la commande (php-fpm, horizon, scheduler…).
ENTRYPOINT ["/usr/local/bin/entrypoint-prod"]
# 🔴 php-fpm, PAS `php -S` — constat A-010 (S0).
#
# `php -S` est le serveur de développement de PHP : UN processus, UNE requête à
# la fois. Mesuré en PRODUCTION le 2026-08-19 — douze requêtes simultanées sur
# `/up` rendaient un escalier de pas 15 ms, quand douze requêtes séquentielles
# restaient plates au même instant sur le même point. Ce n'était pas une
# lenteur du serveur : c'était une mise en file d'attente.
#
# La documentation de PHP dit de ce serveur qu'« il ne devrait pas être utilisé
# sur un réseau public ». Il l'était, derrière Caddy et Cloudflare.
#
# `-F` : rester au premier plan. Docker surveille le processus, pas un démon.
CMD ["php-fpm", "-F"]
