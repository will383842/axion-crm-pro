<?xml version="1.0" encoding="UTF-8"?>
<!--
  ==========================================================================
  Configuration PHPUnit/Pest utilisée UNIQUEMENT par la CI (Gate 0, 2026-08-13)
  ==========================================================================
  ⚠️ 2026-08-16 — LA QUARANTAINE EST LEVÉE. Ce fichier n'écarte plus AUCUN test :
  les 23 fichiers de tests/QUARANTAINE.md ont été réparés ou supprimés, et la CI
  exécute désormais la suite entière. Le document reste en place comme archive de
  ce qui s'est passé, plus comme liste active.

  Il subsiste donc UNE seule différence avec phpunit.xml, et c'est la raison
  d'être de ce fichier : `executionOrder="default"` au lieu de `random`. Deux
  exécutions du MÊME commit avaient donné 262 verts puis 48 rouges — du couplage
  entre tests, pas une régression. Un gate qui change d'avis sans changement de
  code ne vaut rien. L'ordre aléatoire reste actif en local (phpunit.xml) pour
  continuer à débusquer ces couplages.

  Règle qui subsiste : tout NOUVEAU test est bloquant d'office. Réintroduire une
  exclusion ici demande une justification datée — c'est exactement le mécanisme
  qui avait laissé 61 tests non exécutés pendant des mois.
  ==========================================================================
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.4/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         executionOrder="default"
         cacheDirectory=".phpunit.cache"
         beStrictAboutCoverageMetadata="true"
         beStrictAboutOutputDuringTests="true"
         failOnDeprecation="false"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="/>
        <!-- 🔴 H45-005 — LES DIX DRAPEAUX DE SIMULACRE, EPINGLES ICI, AVEC `force`.
             ETAT MESURE LE 2026-08-22 : `.github/workflows/ci.yml` pose DIX
             `MOCK_*` sur le pas Pest (et `docker-compose.test.yml` les memes
             dix) ; ce fichier n'en declarait que DEUX (MOCK_MODE, MOCK_INSEE).
             HUIT manquaient. La suite locale et la CI ne mesuraient donc pas la
             meme chose, et le sens du decalage n'est pas anodin :
             `.env.example` pose MOCK_INSEE, MOCK_ANNUAIRE_ENTREPRISES,
             MOCK_BODACC, MOCK_BAN et MOCK_FRANCE_TRAVAIL a **false**. En local
             ces cinq services partaient donc en HTTP REEL pendant la suite, la
             ou la CI les simulait — un vert de CI qui ne dit rien du vert local,
             et des appels reseau reels depuis un banc de tests.

             POURQUOI `force="true"` SUR CHACUN, et pas seulement la valeur.
             Sans `force`, un `<env>` de PHPUnit n'ecrase PAS une variable deja
             presente dans l'environnement du PROCESSUS — et `docker-compose.yml`
             en pose une par drapeau via `env_file: .env` (l.147). C'est
             exactement le piege deja paye sur `DB_DATABASE` quinze lignes plus
             bas : `composer test` lance DANS le conteneur `api` (ce que
             documente `make test-backend`) lisait la valeur du `.env`, pas
             celle-ci. Un drapeau pose sans `force` y serait reste decoratif.

             CE QUE CE BLOC NE DECIDE PAS. Il ne rend rien simule en production :
             `MockServicesProvider` REFUSE tout simulacre en `production`,
             drapeau ou pas (C18-016/F37-002, garde
             tests/Feature/Infra/AucunSimulacreEnProductionTest.php).

             Garde d'alignement, qui rougit si la CI gagne un onzieme drapeau
             sans qu'il arrive ici :
             tests/Feature/Infra/DrapeauxMockAlignesTest.php -->
        <env name="MOCK_MODE" value="true" force="true"/>
        <env name="MOCK_LLM" value="true" force="true"/>
        <env name="MOCK_PROXIES" value="true" force="true"/>
        <env name="MOCK_SCRAPERS" value="true" force="true"/>
        <env name="MOCK_SMTP" value="true" force="true"/>
        <!-- MOCK_INSEE vivait UNIQUEMENT dans .github/workflows/ci.yml.

             Consequence mesuree le 2026-08-20 : `POST /api/v1/coverage/launch`
             rougit en 500 pour quiconque lance la suite en local avec ce
             fichier-ci, et VERDIT en CI. La queue est en `sync`, le job part
             donc en ligne, atteint `HttpInseeClient::token()` et leve
             « INSEE auth requires either INSEE_API_KEY ... ».

             Un vert qui depend d'une variable absente du fichier de
             configuration est un vert de CI, pas un vert de la suite. -->
        <env name="MOCK_INSEE" value="true" force="true"/>
        <env name="MOCK_ANNUAIRE_ENTREPRISES" value="true" force="true"/>
        <env name="MOCK_BODACC" value="true" force="true"/>
        <env name="MOCK_BAN" value="true" force="true"/>
        <env name="MOCK_FRANCE_TRAVAIL" value="true" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <!-- `force="true"` : cf. la note detaillee dans phpunit.xml. Necessaire mais
             PAS suffisant (PHPUnit n'ecrit pas $_SERVER) — c'est
             `tests/bootstrap.php` qui epingle reellement la base. -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="axion_crm_test" force="true"/>
        <!-- Voir phpunit.xml : la session Postgres est alignée sur
             `app.timezone` pour que le verrou du décalage puisse rougir. -->
        <env name="DB_TIMEZONE" value="Europe/Paris"/>
        <!-- Lot L0 : rôle applicatif non-propriétaire. Mot de passe de TEST
             uniquement (base jetable) — le secret de prod vit dans le .env
             du serveur et dans l'environnement de la CI, jamais ici. -->
        <env name="DB_APP_USERNAME" value="axion_app"/>
        <env name="DB_APP_PASSWORD" value="axion_app_test_only"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
