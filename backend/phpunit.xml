<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.4/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         executionOrder="random"
         cacheDirectory=".phpunit.cache"
         beStrictAboutCoverageMetadata="true"
         beStrictAboutOutputDuringTests="true"
         failOnDeprecation="false"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="/>
        <env name="MOCK_MODE" value="true"/>
        <!-- 🔴 MOCK_INSEE vivait UNIQUEMENT dans .github/workflows/ci.yml:415.

             Consequence mesuree le 2026-08-20 : `POST /api/v1/coverage/launch`
             rougit en 500 pour quiconque lance la suite en local avec ce
             fichier-ci, et VERDIT en CI. La queue est en `sync`, le job part
             donc en ligne, atteint `HttpInseeClient::token()` et leve
             « INSEE auth requires either INSEE_API_KEY ... ».

             Un vert qui depend d'une variable absente du fichier de
             configuration est un vert de CI, pas un vert de la suite. On le
             ramene ici pour que local et CI mesurent la MEME chose : c'est la
             regle 6 du mandat, verifier sur la bonne reference. -->
        <env name="MOCK_INSEE" value="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <!-- 🔴 `force="true"` OBLIGATOIRE sur les deux clés de connexion.
             Sans lui, un `<env>` de PHPUnit n'écrase PAS une variable déjà
             présente dans l'environnement du processus — et `docker-compose.yml`
             en pose une via `env_file: .env` : `DB_DATABASE=axion_crm`.
             Conséquence mesurée le 2026-08-17 : `composer test` lancé DANS le
             conteneur `api` (c'est ce que documente `make test-backend`) visait
             la base de DÉVELOPPEMENT, et `RefreshDatabase` y lançait
             `DROP TABLE … CASCADE` sur une centaine de tables. Seul le rôle
             applicatif non-propriétaire (`CRM_DB_APP_ROLE_ENABLED=true`) l'a
             arrêté ; avec la valeur par défaut, la connexion est SUPERUSER et
             le DROP réussit. Invisible en CI, où aucun `.env` n'est chargé. -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="axion_crm_test" force="true"/>
        <!-- Aligne la session Postgres sur `app.timezone`. En production, la
             variable se pose dans `/opt/axion-crm-pro/.env` sur le serveur
             HETZNER — ce dépôt n'est pas déployé par Coolify (c'est le site
             Axion-IA qui l'est) — et seulement APRÈS la reprise des données
             par `php artisan horodatages:corriger`. Ici elle est toujours
             active, sans quoi `HorodatagesFuseauTest` ne pourrait pas garder
             le correctif. -->
        <env name="DB_TIMEZONE" value="Europe/Paris"/>
        <!-- Lot L0 : rôle applicatif non-propriétaire. Mot de passe de TEST
             uniquement (base jetable) — le secret de prod vit dans le .env
             du serveur et dans l'environnement de la CI, jamais ici. -->
        <env name="DB_APP_USERNAME" value="axion_app"/>
        <env name="DB_APP_PASSWORD" value="axion_app_test_only"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
