[
    {
        "methode": "GET",
        "uri": "api/v1/envoi/feu-vert",
        "middlewares": [
            "api",
            "auth:sanctum",
            "first-login",
            "workspace"
        ]
    },
    {
        "methode": "POST",
        "uri": "api/v1/envoi/feu-vert/{code}/fait",
        "middlewares": [
            "api",
            "auth:sanctum",
            "first-login",
            "permission:workspaces.manage",
            "workspace"
        ]
    },
    {
        "methode": "GET",
        "uri": "api/v1/envoi/opposition/export",
        "middlewares": [
            "api",
            "auth:sanctum",
            "first-login",
            "permission:data.export",
