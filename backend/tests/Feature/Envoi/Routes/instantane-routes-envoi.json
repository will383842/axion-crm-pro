            "throttle:envoi-opposition-export",
            "workspace"
        ]
    },
    {
        "methode": "POST",
        "uri": "api/v1/envoi/puis-je-ecrire",
        "middlewares": [
            "api",
            "auth:sanctum",
            "first-login",
            "permission:users.manage",
            "throttle:envoi-puis-je-ecrire",
            "workspace"
        ]
    },
    {
        "methode": "GET",
        "uri": "api/v1/envoi/sante",
        "middlewares": [
            "api",
            "auth:sanctum",
            "first-login",
            "permission:users.manage",
            "workspace"
        ]
    }
]
