[
    {
        "methode": "GET",
        "uri": "api/v1/envoi/serveurs",
        "middlewares": [
            "api",
            "auth:sanctum",
            "first-login",
            "permission:users.manage",
            "workspace"
        ]
    },
    {
        "methode": "POST",
        "uri": "api/v1/envoi/serveurs/{id}/adresses-ip",
        "middlewares": [
            "api",
            "auth:sanctum",
            "first-login",
            "permission:workspaces.manage",
            "throttle:envoi-infra-ecriture",
            "workspace"
        ]
    },
    {
        "methode": "GET",
        "uri": "api/v1/envoi/serveurs/{id}/sante",
        "middlewares": [
            "api",
            "auth:sanctum",
            "first-login",
            "permission:users.manage",
            "workspace"
        ]
    },
    {
        "methode": "POST",
        "uri": "api/v1/envoi/serveurs/{id}/test",
        "middlewares": [
            "api",
            "auth:sanctum",
            "first-login",
            "permission:workspaces.manage",
            "workspace"
        ]
    }
]
