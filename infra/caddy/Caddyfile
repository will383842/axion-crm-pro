# Axion CRM Pro — Caddy reverse proxy
# Dev local : api.localhost / app.localhost (cert auto-signe via tls internal)
# Prod : app.axion-crm-pro.com (single origin : /api + /sanctum -> backend, reste -> frontend)
#        api.axion-crm-pro.com (backend direct pour curl/debug)

{
    email williamsjullin@gmail.com
    servers {
        # 🔴 `private_ranges` SEUL NE SUFFIT PAS — mesure du 2026-08-27.
        #
        # Cloudflare se presente avec une IP PUBLIQUE. Non declaree ici, elle
        # n'etait pas reconnue comme mandataire : Caddy retenait donc l'IP de
        # Cloudflare comme celle du client, et Laravel, sans confiance declaree
        # de son cote, retenait celle du reseau Docker.
        #
        # Mesure avant correctif, dans `audit_logs` : 84 entrees sur 92 portaient
        # `172.18.0.8` ou `172.18.0.12`. Aucune ne portait l'IP d'un visiteur.
        #
        # Deux consequences, et la premiere est une panne de securite :
        #   · `Limit::perMinute(5)->by($r->ip())` comptait TOUT LE MONDE dans le
        #     meme seau : un attaquant epuisait le quota et verrouillait les
        #     autres, sans etre lui-meme limite.
        #   · le journal d'audit etait inexploitable en cas d'incident — le
        #     manque meme que le registre des violations deplore pour aout.
        #
        # ⚠️ La liste est figee au 2026-08-27. Cloudflare la fait evoluer :
        # https://www.cloudflare.com/ips-v4 et /ips-v6. A revoir si un jour les
        # IP redeviennent fausses.
        trusted_proxies static private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

        # L'en-tete de Cloudflare est le seul qui porte l'IP reelle du visiteur.
        client_ip_headers CF-Connecting-IP X-Forwarded-For
    }
}

# --- DEV : API Laravel ------------------------------------------------------
api.localhost {
    tls internal
    encode zstd gzip
    # 🔴 FastCGI, et non HTTP — constat A-010 (S0) de l'audit 360.
    #
    # L'API était servie par `php -S`, le serveur de développement de PHP : UN
    # processus, UNE requête à la fois. Douze requêtes simultanées mesurées en
    # production formaient un escalier parfait de pas 15 ms. Elle parle désormais
    # FastCGI, sur 9000, par un pool php-fpm (`infra/php/fpm-axion.conf`).
    #
    # `rewrite * /index.php` : Laravel n'a qu'un point d'entrée. Sans cette
    # réécriture, FastCGI reçoit un `SCRIPT_FILENAME` qui n'existe pas et répond
    # 404 sur toutes les routes. On n'emploie PAS la directive `php_fastcgi` :
    # elle teste l'existence des fichiers sur le disque de CADDY, qui ne partage
    # pas celui de l'API.
    #
    # `root` désigne un chemin DANS LE CONTENEUR DE L'API, jamais dans celui-ci :
    # il ne sert qu'à composer `SCRIPT_FILENAME`.
    root * /var/www/html/public
    rewrite * /index.php
    reverse_proxy api:9000 {
        transport fastcgi {
            split .php
        }
        header_up X-Real-IP {remote_host}
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(self), microphone=(), camera=(), interest-cohort=(), browsing-topics=()"
        Content-Security-Policy "default-src 'none'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-site"
        Cache-Control "no-store"
    }
    @docs path /docs /docs/*
    header @docs {
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self' data:"
    }
}

# --- DEV : Frontend SPA -----------------------------------------------------
app.localhost {
    tls internal
    encode zstd gzip

    # SINGLE ORIGIN — exactement comme `app.axion-crm-pro.com` plus bas.
    #
    # 🔴 Ce bloc envoyait TOUT au frontend : le SPA devait donc appeler l'API
    # sur une AUTRE origine (`api.localhost`), et la console était alors
    # inutilisable en local. Deux impasses, mesurées le 2026-08-17 :
    #   · `SESSION_DOMAIN=.localhost` → le cookie de session est REFUSÉ par les
    #     navigateurs (`localhost` est un domaine de premier niveau) → 401 ;
    #   · cookie host-only sur `api.localhost` → le SPA servi depuis
    #     `app.localhost` ne peut plus LIRE `XSRF-TOKEN` (lecture JS
    #     inter-hôtes impossible) → 419 CSRF token mismatch.
    #
    # La production ne connaît pas ce problème : elle est en origine unique
    # depuis le sprint 19.6 (« Evite les third-party cookies »). La décision
    # n'avait simplement jamais été répercutée ici. Le local doit RESSEMBLER à
    # la production, pas diverger d'elle — sinon il ne prouve rien.
    #
    # Poser côté `.env` local, en regard : `VITE_API_BASE_URL=https://app.localhost`
    # et `SESSION_DOMAIN=` (vide → cookie host-only sur `app.localhost`).
    @api {
        path /api/* /sanctum/* /docs /docs/* /up /broadcasting/*
    }
    handle @api {
        # 🔴 FastCGI, et non HTTP — constat A-010 (S0) de l'audit 360.
        #
        # L'API était servie par `php -S`, le serveur de développement de PHP : UN
        # processus, UNE requête à la fois. Douze requêtes simultanées mesurées en
        # production formaient un escalier parfait de pas 15 ms. Elle parle désormais
        # FastCGI, sur 9000, par un pool php-fpm (`infra/php/fpm-axion.conf`).
        #
        # `rewrite * /index.php` : Laravel n'a qu'un point d'entrée. Sans cette
        # réécriture, FastCGI reçoit un `SCRIPT_FILENAME` qui n'existe pas et répond
        # 404 sur toutes les routes. On n'emploie PAS la directive `php_fastcgi` :
        # elle teste l'existence des fichiers sur le disque de CADDY, qui ne partage
        # pas celui de l'API.
        #
        # `root` désigne un chemin DANS LE CONTENEUR DE L'API, jamais dans celui-ci :
        # il ne sert qu'à composer `SCRIPT_FILENAME`.
        root * /var/www/html/public
        rewrite * /index.php
        reverse_proxy api:9000 {
            transport fastcgi {
                split .php
            }
            header_up X-Real-IP {remote_host}
        }
    }

    handle {
        reverse_proxy app:5173 {
            header_up Connection {>Connection}
            header_up Upgrade {>Upgrade}
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(self), microphone=(), camera=(), interest-cohort=(), browsing-topics=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; connect-src 'self' https://api.localhost wss://api.localhost https://*.openfreemap.org wss://app.localhost; font-src 'self' data:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-site"
    }
}

# --- PROD : app.axion-crm-pro.com — SINGLE ORIGIN (frontend + API path-routed)
# Evite les third-party cookies (Chrome 2026 default block).
# Sprint 19.6 — frontend en mode prod (Caddy 2 alpine sert dist/), pas de HMR.
app.axion-crm-pro.com {
    encode zstd gzip

    # Routes API -> backend Laravel
    @api {
        path /api/* /sanctum/* /docs /docs/* /up /broadcasting/*
    }
    handle @api {
        # 🔴 FastCGI, et non HTTP — constat A-010 (S0) de l'audit 360.
        #
        # L'API était servie par `php -S`, le serveur de développement de PHP : UN
        # processus, UNE requête à la fois. Douze requêtes simultanées mesurées en
        # production formaient un escalier parfait de pas 15 ms. Elle parle désormais
        # FastCGI, sur 9000, par un pool php-fpm (`infra/php/fpm-axion.conf`).
        #
        # `rewrite * /index.php` : Laravel n'a qu'un point d'entrée. Sans cette
        # réécriture, FastCGI reçoit un `SCRIPT_FILENAME` qui n'existe pas et répond
        # 404 sur toutes les routes. On n'emploie PAS la directive `php_fastcgi` :
        # elle teste l'existence des fichiers sur le disque de CADDY, qui ne partage
        # pas celui de l'API.
        #
        # `root` désigne un chemin DANS LE CONTENEUR DE L'API, jamais dans celui-ci :
        # il ne sert qu'à composer `SCRIPT_FILENAME`.
        root * /var/www/html/public
        rewrite * /index.php
        reverse_proxy api:9000 {
            transport fastcgi {
                split .php
            }
            header_up X-Real-IP {remote_host}
        }
    }

    # Tout le reste -> frontend (Caddy interne sert dist/ statique)
    handle {
        reverse_proxy app:5173 {
            header_up X-Real-IP {remote_host}
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# --- PROD : api.axion-crm-pro.com — backend direct (curl/debug)
