# Axion CRM Pro — Caddy reverse proxy
# Dev local : api.localhost / app.localhost (cert auto-signe via tls internal)
# Prod : app.axion-crm-pro.com (single origin : /api + /sanctum -> backend, reste -> frontend)
#        api.axion-crm-pro.com (backend direct pour curl/debug)

{
    email williamsjullin@gmail.com
    servers {
        trusted_proxies static private_ranges
    }
}

# --- DEV : API Laravel ------------------------------------------------------
api.localhost {
    tls internal
    encode zstd gzip
    reverse_proxy api:80 {
        header_up X-Real-IP {remote_host}
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(self), microphone=(), camera=(), interest-cohort=(), browsing-topics=()"
        Content-Security-Policy "default-src 'none'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-site"
        Cache-Control "no-store"
    }
    @docs path /docs /docs/*
    header @docs {
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self' data:"
    }
}

# --- DEV : Frontend SPA -----------------------------------------------------
app.localhost {
    tls internal
    encode zstd gzip

    # SINGLE ORIGIN — exactement comme `app.axion-crm-pro.com` plus bas.
    #
    # 🔴 Ce bloc envoyait TOUT au frontend : le SPA devait donc appeler l'API
    # sur une AUTRE origine (`api.localhost`), et la console était alors
    # inutilisable en local. Deux impasses, mesurées le 2026-08-17 :
    #   · `SESSION_DOMAIN=.localhost` → le cookie de session est REFUSÉ par les
    #     navigateurs (`localhost` est un domaine de premier niveau) → 401 ;
    #   · cookie host-only sur `api.localhost` → le SPA servi depuis
    #     `app.localhost` ne peut plus LIRE `XSRF-TOKEN` (lecture JS
    #     inter-hôtes impossible) → 419 CSRF token mismatch.
    #
    # La production ne connaît pas ce problème : elle est en origine unique
    # depuis le sprint 19.6 (« Evite les third-party cookies »). La décision
    # n'avait simplement jamais été répercutée ici. Le local doit RESSEMBLER à
    # la production, pas diverger d'elle — sinon il ne prouve rien.
    #
    # Poser côté `.env` local, en regard : `VITE_API_BASE_URL=https://app.localhost`
    # et `SESSION_DOMAIN=` (vide → cookie host-only sur `app.localhost`).
    @api {
        path /api/* /sanctum/* /docs /docs/* /up /broadcasting/*
    }
    handle @api {
        reverse_proxy api:80 {
            header_up X-Real-IP {remote_host}
        }
    }

    handle {
        reverse_proxy app:5173 {
            header_up Connection {>Connection}
            header_up Upgrade {>Upgrade}
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(self), microphone=(), camera=(), interest-cohort=(), browsing-topics=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; connect-src 'self' https://api.localhost wss://api.localhost https://*.openfreemap.org wss://app.localhost; font-src 'self' data:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-site"
    }
}

# --- PROD : app.axion-crm-pro.com — SINGLE ORIGIN (frontend + API path-routed)
# Evite les third-party cookies (Chrome 2026 default block).
# Sprint 19.6 — frontend en mode prod (Caddy 2 alpine sert dist/), pas de HMR.
app.axion-crm-pro.com {
    encode zstd gzip

    # Routes API -> backend Laravel
    @api {
        path /api/* /sanctum/* /docs /docs/* /up /broadcasting/*
    }
    handle @api {
        reverse_proxy api:80 {
            header_up X-Real-IP {remote_host}
        }
    }

    # Tout le reste -> frontend (Caddy interne sert dist/ statique)
    handle {
        reverse_proxy app:5173 {
            header_up X-Real-IP {remote_host}
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# --- PROD : api.axion-crm-pro.com — backend direct (curl/debug)
api.axion-crm-pro.com {
    encode zstd gzip
    reverse_proxy api:80 {
        header_up X-Real-IP {remote_host}
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# ============================================================================
# PRÉPRODUCTION (2026-08-19) — servie par CE Caddy, celui de la production.
# ============================================================================
#
# Un seul processus peut tenir 80 et 443 : la pile de préproduction n'a donc
# aucun Caddy à elle. C'est celui-ci qui sert les deux noms `staging.*`.
#
# POURQUOI `host.docker.internal` ET PAS LE NOM DES CONTENEURS
#
# La solution naturelle — attacher ce Caddy au réseau de la préproduction — est
# un piège : Compose ajoute TOUJOURS le nom du service comme alias réseau, et on
# ne peut pas le retirer. Ce conteneur verrait donc `api` sur ses DEUX réseaux,
# et le routage de la PRODUCTION deviendrait indéterminé — une panne
# intermittente, impossible à reproduire, sur le site en marche.
#
# La pile de préproduction publie donc ses deux services sur la BOUCLE LOCALE de
# l'hôte (`127.0.0.1:8081` frontend, `127.0.0.1:8082` API, cf.
# `docker-compose.staging.yml`). Les deux réseaux Docker restent totalement
# étanches, et rien n'est joignable depuis internet.
#
# `host.docker.internal` est résolu grâce à `extra_hosts: host-gateway` posé sur
# le service `caddy` de `docker-compose.prod.yml`. Sans lui, ces deux blocs
# renverraient 502 — et Caddy démarrerait quand même : un `reverse_proxy` vers
# un hôte inconnu n'est PAS une erreur de configuration, donc `caddy validate`
# ne l'attrapera pas. C'est le contrôle APRÈS déploiement qui le dira.
#
# Une faute de frappe ici casse TOUTE LA PRODUCTION, pas seulement la
# préproduction : Caddy refuse de démarrer sur un fichier invalide. Garde : job
# CI `caddyfile-valide`, qui prouve à chaque exécution qu'il sait rougir.

# --- PRÉPROD : staging.axion-crm-pro.com — origine unique, comme la prod
staging.axion-crm-pro.com {
    encode zstd gzip

    @api {
        path /api/* /sanctum/* /docs /docs/* /up /broadcasting/*
    }
    handle @api {
        reverse_proxy host.docker.internal:8082 {
            header_up X-Real-IP {remote_host}
        }
    }

    handle {
        reverse_proxy host.docker.internal:8081 {
            header_up X-Real-IP {remote_host}
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Robots-Tag "noindex, nofollow, noarchive"
    }
}

# --- PRÉPROD : staging-api.axion-crm-pro.com — backend direct (curl/debug)
staging-api.axion-crm-pro.com {
    encode zstd gzip
    reverse_proxy host.docker.internal:8082 {
        header_up X-Real-IP {remote_host}
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Robots-Tag "noindex, nofollow, noarchive"
    }
}
