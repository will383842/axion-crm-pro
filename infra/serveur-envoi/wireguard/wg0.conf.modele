# Tunnel CRM <-> serveur d'envoi. Modele : les marqueurs sont remplaces par
# l'installateur ; la cle privee est generee SUR le serveur, jamais committee.
[Interface]
Address = <ip-tunnel>/32
ListenPort = <port-wg>
PrivateKey = <cle-privee-serveur>

[Peer]
# Le CRM : seul pair autorise, seule IP de tunnel autorisee.
PublicKey = <cle-publique-crm>
AllowedIPs = <ip-tunnel-crm>/32
PersistentKeepalive = 25
